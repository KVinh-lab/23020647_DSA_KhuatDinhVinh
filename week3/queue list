
#include <iostream>
#include <list>
using namespace std;

class QueueList {
private:
    list<int> q;

public:
    // Kiem tra Queue rong
    bool isEmpty() {
        return q.empty();
    }

    // Them phan tu vao cuoi Queue
    void enqueue(int x) {
        q.push_back(x);
        cout << "Da them " << x << " vao Queue!\n";
    }

    // Xoa phan tu dau Queue
    void dequeue() {
        if (isEmpty()) {
            cout << "Queue rong, khong the dequeue!\n";
            return;
        }

        cout << "Da xoa phan tu: " << q.front() << endl;
        q.pop_front();
    }

    // Lay phan tu dau Queue
    int front() {
        if (isEmpty()) {
            cout << "Queue rong!\n";
            return -1;
        }

        return q.front();
    }

    // Hien thi Queue
    void display() {
        if (isEmpty()) {
            cout << "Queue rong!\n";
            return;
        }

        cout << "Queue (Front -> Rear): ";

        for (int x : q) {
            cout << x << " ";
        }

        cout << endl;
    }
};

int main() {
    QueueList q;
    int choice, x;

    do {
        cout << "\n===== QUEUE STL LIST =====\n";
        cout << "1. Enqueue\n";
        cout << "2. Dequeue\n";
        cout << "3. Front\n";
        cout << "4. Kiem tra rong\n";
        cout << "5. Hien thi Queue\n";
        cout << "0. Thoat\n";
        cout << "Nhap lua chon: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Nhap so nguyen: ";
                cin >> x;
                q.enqueue(x);
                break;

            case 2:
                q.dequeue();
                break;

            case 3:
                if (!q.isEmpty())
                    cout << "Phan tu Front: " << q.front() << endl;
                else
                    cout << "Queue rong!\n";
                break;

            case 4:
                cout << (q.isEmpty() ? "Queue rong\n" : "Queue khong rong\n");
                break;

            case 5:
                q.display();
                break;

            case 0:
                cout << "Ket thuc chuong trinh!\n";
                break;

            default:
                cout << "Lua chon khong hop le!\n";
        }

    } while (choice != 0);

    return 0;
}
